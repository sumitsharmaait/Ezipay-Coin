<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. The wallet data is encrypted with a Keystore key that is never backed up,
     so a restored copy could not be read. Nothing is included. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
